<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_common</name>
  <version>0.1.0</version>
  <description>Shared UR5 + SharpA kinematics: the single FK/IK entry point for teleop and deploy.</description>
  <maintainer email="ur.sharpa@example.com">ur-sharpa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- pinocchio: only needed for hand fingertip FK; arm FK/IK works without it. -->
  <exec_depend>python3-pinocchio</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
