# Ask the observation aggregator to assemble one policy input from the current
# buffers and return it msgpack-encoded. Called by policy_client immediately
# before each inference request.

# Full MetadataFormat dict as JSON; selects which modalities and how much
# history to include.
string metadata_format_json
string session_id
uint64 request_id

# Time the request was issued, nanoseconds. Freshness is judged against this.
uint64 timestamp_ns

# Task prompt to embed in the observation.
string prompt

# Previous ExecutionDone rendered as the execution_feedback dict, JSON.
# Empty string on the first request of a session.
# executed_steps inside it is CUMULATIVE (see ExecutionDone.msg).
string execution_feedback_json

# Reject rather than truncate if the encoded observation exceeds this many
# bytes. 0 disables the check.
uint64 max_message_size
---
bool success

# True when the caller may retry unchanged, e.g. a buffer was still filling.
bool retryable

# Machine-readable failure code, empty on success.
string error_code

# Human-readable failure detail, empty on success.
string error_message

# msgpack-encoded sharpa_policy_observation.v3 dict. Empty when success=false.
uint8[] observation_msgpack

# seq of the PolicyObs published for this build, for log correlation.
uint64 obs_seq
