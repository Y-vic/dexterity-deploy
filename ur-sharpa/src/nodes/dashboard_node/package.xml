<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dashboard_node</name>
  <version>0.1.0</version>
  <description>Machine, remote model and policy dashboard for dual UR5 + SharpA.</description>
  <maintainer email="ur.sharpa@example.com">ur-sharpa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ur_msgs</exec_depend>
  <exec_depend>ur_common</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- pybullet: offscreen sim rendering for panels 2 and 5. OPTIONAL - the node
       serves the non-sim panels and says so on the page when it is missing. -->
  <!-- Pillow: JPEG encode of rendered frames. OPTIONAL, same degradation. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
