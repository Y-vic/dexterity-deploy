<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ws_core</name>
  <version>0.1.0</version>
  <description>Workstation core observation, policy, and actor sync nodes.</description>
  <maintainer email="pnd.humanoid@example.com">pnd-humanoid</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ws_msgs</depend>
  <depend>deploy_common</depend>
  <exec_depend>adam_sharpa_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>python3-msgpack</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
