# Canonical colcon output roots for the UR SharpA workspace.
ur-sharpa/build/
ur-sharpa/install/
ur-sharpa/log/
ur-sharpa/build-clean/
ur-sharpa/install-clean/
ur-sharpa/log-clean/
ur-sharpa/build-*/
ur-sharpa/install-*/
ur-sharpa/log-*/
ur-sharpa/build_*/
ur-sharpa/install_*/
ur-sharpa/log_*/
